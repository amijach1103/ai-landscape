{
  "manifest_version": 3,
  "name": "AI Newsletter Collector",
  "version": "1.0",
  "description": "Collect articles for your weekly AI newsletter",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save article for newsletter"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
